{
  "name": "react-text-truncate-lite",
  "version": "0.1.0",
  "description": "Lightweight, responsive React text truncation with multiline clamping, custom ellipses, RTL support, and graceful browser fallbacks.",
  "license": "MIT",
  "author": "Sobhan Yazdanjoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sob-hon/react-text-truncate.git"
  },
  "homepage": "https://github.com/sob-hon/react-text-truncate#readme",
  "bugs": {
    "url": "https://github.com/sob-hon/react-text-truncate/issues"
  },
  "keywords": [
    "react",
    "truncate",
    "text",
    "ellipsis",
    "line-clamp",
    "multiline",
    "rtl",
    "responsive",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "example:build": "esbuild examples/showcase.tsx --bundle --format=esm --jsx=automatic --outfile=examples/dist/showcase.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check && npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0 <20.0.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
